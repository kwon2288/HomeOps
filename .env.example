# .env 로 복사해서 사용하세요. .env 는 git에 올라가지 않습니다.

# 웹 로그인 계정
HOMEOPS_ADMIN_USER=admin
HOMEOPS_ADMIN_PASSWORD=change-me

# 세션 서명 키. 아래 명령으로 생성:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOMEOPS_SECRET_KEY=

# HTTPS(NPM 리버스 프록시) 뒤에서 쓸 때는 true.
# http://IP:8080 으로 직접 접속해 테스트할 때만 false (true면 로그인 쿠키가 저장되지 않음)
HOMEOPS_COOKIE_SECURE=false

# Hubitat 백업 파일 보관 개수 (허브별)
HOMEOPS_BACKUP_KEEP=10
